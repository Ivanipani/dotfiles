{
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/jj-context.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/handoff-context.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"$HOME/.{{ client }}/hooks/quota-guard.sh\" {{ client }}"}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "\"$HOME/.{{ client }}/hooks/quota-guard.sh\" {{ client }}"}]}],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/jj-guard.sh\""
          }
        ]
      }
    ],
{% if client == "claude" %}
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|agent_completed|elicitation_dialog|elicitation_url_dialog|quota_auto_resume_fired|quota_auto_resume_stale",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/notify.sh\""
          }
        ]
      }
    ],
{% else %}
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "\"$HOME/.codex/hooks/notify.sh\" Codex"}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "\"$HOME/.codex/hooks/notify.sh\" Codex"}]}],
{% endif %}
    "Stop": [
      {
        "hooks": [
{% if client == "codex" %}
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/notify.sh\" Codex"
          },
{% endif %}
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/quota-guard.sh\" {{ client }}"
          },
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/reek-check.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/jj-commit.sh\""
          }
        ]
      }
    ]
  }
