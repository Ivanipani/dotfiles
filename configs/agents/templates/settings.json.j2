{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
{% for cmd in v.agents.allowed_commands %}
      "Bash({{ cmd | join(' ') }} *)"{{ "," if not loop.last }}
{% endfor %}
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "theme": "light",
  "editorMode": "vim",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline"
  },
  "skipAutoPermissionPrompt": true{% if v.claude.auto_mode %},
  "autoMode": {{ v.claude.auto_mode | json | indent(2) }}{% endif %},
  "hooks": {% include "templates/hooks.json.j2" %}
}
