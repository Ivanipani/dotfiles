layout {
    // Chrome, declared once per layout: the builtin tab-bar still owns tabs,
    // and zjstatus (configured in config.kdl) owns everything else.
    pane_template name="tabbar" borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane_template name="statusbar" borderless=true {
        plugin location="zjstatus"
    }

    tab name="editor" hide_floating_panes=true focus=true {
        tabbar size=1
        pane command="nvim" borderless=true {
            args "."
        }
        statusbar size=1
    }
    tab name="claude" hide_floating_panes=true {
        tabbar size=1
        pane command="claude" borderless=true {
            args "."
        }
        statusbar size=1
    }
    tab name="jj" hide_floating_panes=true {
        tabbar size=1
        pane command="jjui" size="60%"
        pane size="40%"
        statusbar size=1
    }
    tab name="tests" hide_floating_panes=true {
        tabbar size=1
        pane stacked=true {
            pane name="host" expanded=true {
            }
            pane name="docker"
        }
        statusbar size=1
    }
    new_tab_template {
        tabbar size=1
        pane
        statusbar size=1
    }
}
