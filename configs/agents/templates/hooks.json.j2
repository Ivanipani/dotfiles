{
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/jj-context.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/handoff-context.sh\""
          },
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent {{ client }} --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          },
          {"type": "command", "command": "\"$HOME/.{{ client }}/hooks/rex-status.sh\" {{ 'claude-code' if client == 'claude' else 'codex' }}"}
        ]
      }
    ],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"$HOME/.{{ client }}/hooks/quota-guard.sh\" {{ client }}"}, {"type": "command", "command": "\"$HOME/.{{ client }}/hooks/rex-status.sh\" {{ 'claude-code' if client == 'claude' else 'codex' }}"}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "\"$HOME/.{{ client }}/hooks/quota-guard.sh\" {{ client }}"}, {"type": "command", "command": "\"$HOME/.{{ client }}/hooks/rex-status.sh\" {{ 'claude-code' if client == 'claude' else 'codex' }}"}]}],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/jj-guard.sh\""
          }
        ]
      }
    ],
{% if client == "claude" %}
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|agent_completed|elicitation_dialog|elicitation_url_dialog|quota_auto_resume_fired|quota_auto_resume_stale",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/notify.sh\""
          },
          {"type": "command", "command": "\"$HOME/.{{ client }}/hooks/rex-status.sh\" {{ 'claude-code' if client == 'claude' else 'codex' }}"}
        ]
      }
    ],
{% else %}
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "\"$HOME/.codex/hooks/notify.sh\" Codex"}, {"type": "command", "command": "\"$HOME/.{{ client }}/hooks/rex-status.sh\" {{ 'claude-code' if client == 'claude' else 'codex' }}"}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "\"$HOME/.codex/hooks/notify.sh\" Codex"}, {"type": "command", "command": "\"$HOME/.{{ client }}/hooks/rex-status.sh\" {{ 'claude-code' if client == 'claude' else 'codex' }}"}]}],
{% endif %}
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "\"$HOME/.{{ client }}/hooks/rex-status.sh\" {{ 'claude-code' if client == 'claude' else 'codex' }}"},
{% if client == "codex" %}
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/notify.sh\" Codex"
          },
{% endif %}
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/quota-guard.sh\" {{ client }}"
          },
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/reek-check.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.{{ client }}/hooks/jj-commit.sh\""
          }
        ]
      }
    ]
  }
