// Tab layout for zellij-workspace: the first `tab` is copied once per project
// (name and cwd are filled in by the plugin); everything else is kept once.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        pane size=2 borderless=true {
            plugin location="zjkeys"
        }
    }

    tab hide_floating_panes=true focus=true {
        pane split_direction="vertical" {
            pane command="nvim" size="60%" borderless=true {
                args "."
            }
            pane command="claude" size="40%" borderless=true {
                args "."
            }
        }
    }
}
