# Rendered by `dot` from vcs/templates/jj-config.toml.j2 — edit the template, then `dot apply`.
[user]
name = "{{ v.user.name }}"
email = "{{ v.user.email }}"

[ui]
diff-editor = ["{{ v.editor.command }}", "-c", "DiffEditor $left $right $output"]
# Limits keep difft from eating GBs: past them it falls back to a line diff.
# Noisy/generated files are forced to plain text for the same reason.
diff-formatter = [
  "difft", "--color=always",
  "--graph-limit=300000", "--byte-limit=200000", "--parse-error-limit=50",
  "--override=*.lock:text", "--override=*-lock.json:text", "--override=*.lock.json:text",
  "--override=*.min.js:text", "--override=*.min.css:text", "--override=*.map:text",
  "--override=*.svg:text", "--override=*.snap:text", "--override=*.sum:text",
  "$left", "$right",
]
merge-editor = "{{ v.editor.command }}"
# Standard `<<<<<<< ||||||| ======= >>>>>>>` markers instead of jj's own
# `%%%%%%%` diff style, so conflicts left in the working copy look the same as
# the ones the merge editor opens (and every other tool understands them).
conflict-marker-style = "git"

# Resolve conflicts by editing the markers directly, with nvim/config/lua/jj/
# conflict.lua providing navigation, per-side highlighting and co/ct/cb/ca/cn.
# Beats the builtin editor, which can only take whole sides.
[merge-tools.nvim]
program = "nvim"
merge-args = ["$output", "-c", "JJResolve $left $base $right"]
merge-tool-edits-conflict-markers = true
conflict-marker-style = "git"

[snapshot]
# Workspaces sharing a repo go stale whenever another rewrites their @.
auto-update-stale = true

[git]
private-commits = "description(glob:'wip:*') | description(glob:'private:*') | bookmarks(private)"
# push-new-bookmarks = true

[remotes.origin]
auto-track-bookmarks = "*"

# Views over the revsets of conf.d/flight.toml.
[aliases]
flight = ["log", "-r", "flight()"]
landed = ["bookmark", "list", "-r", "landed()"]
orphans = ["log", "-r", "orphaned()"]
# Delete landed bookmarks here and on their remotes; --orphans also abandons orphaned work.
tidy = ["util", "exec", "--", "rex-workspace", "tidy"]
