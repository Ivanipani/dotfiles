layout {
{% include "templates/tab-template.kdl.j2" %}
    tab name="editor" hide_floating_panes=true focus=true {
        pane command="nvim" {
            args "."
        }
    }
    tab name="claude" hide_floating_panes=true {
        pane command="claude" {
            args "."
        }
    }
    tab name="jj" hide_floating_panes=true {
        pane command="jjui" size="60%"
        pane size="40%"
    }
    tab name="tests" hide_floating_panes=true {
        pane stacked=true {
            pane name="host" expanded=true {
            }
            pane name="docker"
        }
    }
}
