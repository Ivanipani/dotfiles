layout {
    // Chrome, declared once and inherited by every tab below — and by tabs
    // opened later, since zellij falls back to this template when there is no
    // `new_tab_template`. Tabs stay in the builtin tab-bar; zjstatus (configured
    // in config.kdl) owns the widgets; the builtin status-bar owns the keybind
    // menu, which is the only thing that reads the real bindings.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        // Widgets above the menu: the menu redraws as you step through a mode,
        // so it wants to be the line nearest the panes it is talking about.
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="editor" hide_floating_panes=true focus=true {
        pane command="nvim" borderless=true {
            args "."
        }
    }
    tab name="jj" hide_floating_panes=true {
        pane command="jjui" size="80%"
        pane size="20%"
    }
    tab name="shell" hide_floating_panes=true {
        pane stacked=true {
            pane expanded=true {
            }
            pane
        }
    }
}
