layout {
    // Every tab inherits the tab bar, widgets, and mode-aware zjstatus hints.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        pane size=1 borderless=true {
            plugin location="zjkeys"
        }
    }

    tab name="editor" hide_floating_panes=true focus=true {
        pane command="nvim" {
            args "."
        }
    }
    tab name="jj" hide_floating_panes=true {
        pane command="jjui" size="80%"
        pane size="20%"
    }
    tab name="shell" hide_floating_panes=true {
        pane stacked=true {
            pane expanded=true {
            }
            pane
        }
    }
}
