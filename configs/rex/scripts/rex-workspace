#!/usr/bin/env nu
# Workspace sets of jj workspaces as Rex sessions: the Rex counterpart of
# src/zellij-workspace. Shares its on-disk format (<dir>/<set>/workspace.yaml),
# so a set opens from either. Session `ws-<set>`: a tab at the set root, then per
# project nvim | agent split tiled, with jjui in a floating layer.

const FALLBACK_REX = "/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex"
const SHELL = "com.superlogical.terminal.shell"
const JJUI_BOUNDS = [0.05 0.05 0.9 0.9]
const MAX_DEPTH = 3

# --- environment -----------------------------------------------------------

def rex-bin [] {
  if ($env.REX_BIN? | is-not-empty) { return $env.REX_BIN }
  let local = ($env.REX_BIN_DIR? | default "" | path join rex)
  if ($env.REX_BIN_DIR? | is-not-empty) and ($local | path exists) { return $local }
  if (which rex | is-not-empty) { return "rex" }
  if ($FALLBACK_REX | path exists) { $FALLBACK_REX } else { "" }
}

def --wrapped rx [...args: string] {
  let bin = (rex-bin)
  if ($bin | is-empty) { error make {msg: "rex not found"} }
  run-external $bin ...$args
}

def rex-call [session: string, method: string, args: record = {}] {
  rx api call -s $session $method ($args | to json -r) | from json
}

def workspaces-dir [] {
  $env.REX_WORKSPACES_DIR? | default ($nu.home-path | path join .local share workspaces)
}

def roots [] {
  $env.REX_WORKSPACE_ROOTS? | default $"($nu.home-path)/github:($nu.home-path)" | split row ":"
}

def set-dir [set: string] { workspaces-dir | path join $set }

def session-label [set: string] { $"ws-($set)" }

# The set of the session this runs in, when it is a `ws-` session.
def current-set [] {
  let id = $env.REX_SESSION? | default ""
  let label = (sessions | where session_id == $id | get label.0? | default "")
  if not ($label | str starts-with "ws-") {
    error make {msg: "no set given and not inside a ws- session"}
  }
  $label | str replace --regex '^ws-' ""
}

def resolve-set [set?: string] {
  if ($set | is-empty) { current-set } else { $set }
}

def sessions [] {
  if (rex-bin | is-empty) { return [] }
  try { rx ls --json | from json | get sessions } catch { [] }
}

def find-session [set: string] {
  sessions | where label == (session-label $set) | get session_id.0?
}

# --- manifest --------------------------------------------------------------

def load-manifest [set: string] {
  let file = (set-dir $set | path join workspace.yaml)
  if ($file | path exists) { open $file } else { {name: $set, projects: []} }
}

def agents-md [m: record] {
  let projects = ($m.projects | each {|c|
    if ($c.source? | is-empty) { $"- `($c.name)/`\n" } else { $"- `($c.name)/` — from `($c.source)`\n" }
  } | str join)
  $"# Workspace: ($m.name)

This directory is a special-purpose workspace set named `($m.name)`, created to develop one feature across several projects. It is generated by the zellij-workspace plugin; do not edit this file, it is rewritten whenever the set changes.

## Layout

Each subdirectory below is a [jujutsu]\(https://jj-vcs.github.io/jj/) workspace of a separate repository, not a clone. Its source repository shares the same commit graph.

($projects)
## Working here

- Use `jj`, never `git`, for version control. Run it inside the project you are changing.
- Keep changes scoped to the feature this workspace exists for.
- Each workspace has its own working-copy commit \(`@`); changes are committed to the shared repository as soon as `jj` runs. Describe them with `jj describe`.
- Do not run `jj workspace forget` or delete project directories. Membership is managed through the plugin and `workspace.yaml`.
- Do not touch the source repositories directly.
"
}

# Writes workspace.yaml and AGENTS.md; a real CLAUDE.md is left alone, otherwise it links to AGENTS.md.
def save-manifest [m: record] {
  let dir = (set-dir $m.name)
  let m = ($m | update projects ($m.projects | sort-by name))
  mkdir $dir
  $m | to yaml | save -f ($dir | path join workspace.yaml)
  agents-md $m | save -f ($dir | path join AGENTS.md)
  let claude = ($dir | path join CLAUDE.md)
  if not ($claude | path exists) or ($claude | path type) == symlink {
    ^ln -sfn AGENTS.md $claude
  }
}

# --- repositories ----------------------------------------------------------

# Primary jj repositories under the roots (`.jj/repo` is a directory; secondary workspaces have a file).
def scan-repos [] {
  let found = (roots | each {|root|
    1..$MAX_DEPTH | each {|d|
      glob $"($root)(1..$d | each { '/*' } | str join)/.jj/repo" | where {|p| ($p | path type) == dir }
    } | flatten
  } | flatten | each { path dirname | path dirname } | uniq | sort)
  let names = ($found | each { path basename })
  $found | each {|source|
    let base = ($source | path basename)
    let dup = ($names | where $it == $base | length) > 1
    {name: (if $dup { $"($source | path dirname | path basename)-($base)" } else { $base }), source: $source}
  }
}

# Picks entries of `items` (records with a name) by name; fzf when `names` is empty.
def pick [items: list, names: list<string>, prompt: string] {
  if ($names | is-not-empty) {
    let missing = ($names | where $it not-in ($items | get name))
    if ($missing | is-not-empty) { error make {msg: $"unknown: ($missing | str join ', ')"} }
    return ($items | where name in $names)
  }
  let lines = ($items | each {|i| $"($i.name)\t($i.source? | default '')" })
  let chosen = ($lines | str join "\n" | ^fzf --multi --prompt $prompt --delimiter "\t" | lines | each { split row "\t" | get 0 })
  $items | where name in $chosen
}

# --- jj --------------------------------------------------------------------

# Keeps uncommitted work alive under a saved-<set> bookmark, then forgets the workspace.
# A workspace whose source repository is gone is left for plain deletion.
def forget [dir: string] {
  if (do -i { ^jj -R $dir log -r @ --no-graph -T empty } | complete).exit_code != 0 { return }
  if (^jj -R $dir log -r @ --no-graph -T empty | str trim) == "false" {
    let base = $"saved-($dir | path dirname | path basename)"
    mut name = $base
    mut n = 1
    while (^jj -R $dir bookmark list -T 'name ++ "\n"' $"exact:($name)" | str trim | is-not-empty) {
      $n += 1
      $name = $"($base)-($n)"
    }
    ^jj -R $dir bookmark create $name -r @
    print $"saved ($name) in ($dir | path basename)"
  }
  ^jj -R $dir workspace forget
}

# --- session layout --------------------------------------------------------

def block [label: string, cwd: string, command: list<string> = []] {
  let options = {cwd: $cwd} | merge (if ($command | is-empty) { {} } else { {command: $command} })
  {block: {flavor: $SHELL, label: $label, options: $options}}
}

# Server-spawned blocks get a bare PATH; run through the user's login shell to get ~/.local/bin etc.
def in-shell [line: string] { [($env.SHELL? | default zsh) -lic $line] }

# Tiled nvim | agent split, plus jjui in a minimized floating layer.
def add-window [session: string, name: string, dir: string] {
  let split = {split: {direction: horizontal, ratio: 0.6, before: (block nvim $dir (in-shell 'exec nvim .')), after: (block agent $dir (in-shell 'exec claude'))}}
  let win = (rex-call $session session.new_window {window_label: $name, layout: $split, focus: false})
  let layer = (rex-call $session session.new_layer {window_id: $win.window_id, bounds: $JJUI_BOUNDS, layout: (block jjui $dir (in-shell 'while jjui; do :; done'))})
  rex-call $session session.set_layer_state {layer_id: $layer.layer_id, state: minimized} | ignore
}

def close-window [session: string, name: string] {
  let view = (rex-call $session session.view)
  for w in ($view.windows | where label == $name) {
    rex-call $session session.close_window {window_id: $w.window_id} | ignore
  }
}

# --- commands --------------------------------------------------------------

# List workspace sets.
def "main ls" [] {
  let live = (sessions | get label)
  glob $"(workspaces-dir)/*/workspace.yaml" | each {|f|
    let m = (open $f)
    {set: $m.name, projects: ($m.projects | get name | str join ' '), open: ((session-label $m.name) in $live)}
  }
}

# Open a set as a Rex session, or switch to it if it is already open.
def "main open" [set?: string] {
  let set = if ($set | is-empty) {
    main ls | get set | to text | ^fzf --prompt "open workspace> " | str trim
  } else { $set }
  if ($set | is-empty) { return }
  let m = (load-manifest $set)
  if ($m.projects | is-empty) { error make {msg: $"no set named ($set)"} }
  let existing = (find-session $set)
  let id = if ($existing | is-not-empty) { $existing } else {
    let created = (rx new (session-label $set) -c (set-dir $set) --window $set --json | from json)
    for p in $m.projects { add-window $created.session_id $p.name (set-dir $set | path join $p.name) }
    $created.session_id
  }
  # No app attached (headless, or several): the session is still created.
  try { rx do session.select $"session_id=($id)" } catch { print -e $"opened ($id); could not switch; enable Remote Control in Rex Settings > Rex Server" }
}

# Create a set from repositories (fzf when none are named), then open it.
def "main new" [set: string, ...repos: string] {
  if (set-dir $set | path exists) { error make {msg: $"($set) already exists"} }
  main add $set ...$repos
  main open $set
}

# Add repositories to a set (the current one inside a ws- session).
def "main add" [set?: string, ...repos: string] {
  let set = (resolve-set $set)
  let m = (load-manifest $set)
  let candidates = (scan-repos | where name not-in ($m.projects | get name))
  let picks = (pick $candidates $repos "add> ")
  mkdir (set-dir $set)
  for p in $picks {
    let dir = (set-dir $set | path join $p.name)
    ^jj -R $p.source workspace add --name $set $dir
    ^jj -R $dir config set --workspace snapshot.auto-update-stale true
  }
  save-manifest ($m | update projects ($m.projects | append $picks))
  let session = (find-session $set)
  if ($session | is-not-empty) {
    for p in $picks { add-window $session $p.name (set-dir $set | path join $p.name) }
  }
}

# Remove projects from a set (the current one inside a ws- session).
def "main remove" [set?: string, ...projects: string] {
  let set = (resolve-set $set)
  let m = (load-manifest $set)
  let picks = (pick $m.projects $projects "remove> ")
  let session = (find-session $set)
  for p in $picks {
    let dir = (set-dir $set | path join $p.name)
    forget $dir
    rm -rf $dir
    if ($session | is-not-empty) { close-window $session $p.name }
  }
  save-manifest ($m | update projects ($m.projects | where name not-in ($picks | get name)))
}

# Delete a set: save dirty workspaces under bookmarks, forget them, remove the directory and session.
def "main delete" [set?: string, --yes (-y)] {
  let set = (resolve-set $set)
  let dir = (set-dir $set)
  if not ($dir | path exists) { error make {msg: $"no set named ($set)"} }
  if not $yes and (input $"Delete workspace set ($set)? [y/N] " | str downcase) != "y" { return }
  for d in (glob $"($dir)/*" --no-file) { forget $d }
  rm -rf $dir
  let session = (find-session $set)
  if ($session | is-not-empty) { rx kill $session }
}

def main [] { help main }
