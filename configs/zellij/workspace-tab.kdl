// Shared layout nodes for zellij-workspace: the plugin adds two tabs per project
// (nvim and jjui, in the project root); everything here is kept once.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        pane size=1 borderless=true {
            plugin location="zjkeys"
        }
    }
}
